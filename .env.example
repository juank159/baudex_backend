# ============================================
# CONFIGURACIÓN DE ENTORNO - SISTEMA PEPS/FIFO
# ============================================

# Environment
NODE_ENV=development
PORT=3000
APP_PORT=3000

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password_super_seguro
DB_NAME=baudex

# Para Docker (usar nombre del servicio)
# DB_HOST=db

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=tu_jwt_secret_super_mega_seguro_de_al_menos_32_caracteres
JWT_EXPIRATION=7d

# ============================================
# PGADMIN CONFIGURATION (opcional)
# ============================================
PGADMIN_EMAIL=admin@baudex.com
PGADMIN_PASSWORD=admin_password_seguro

# ============================================
# API CONFIGURATION
# ============================================
API_PREFIX=api
API_VERSION=v1
SWAGGER_PATH=api-docs

# ============================================
# SECURITY SETTINGS
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=info
LOG_FORMAT=combined

# ============================================
# BUSINESS CONFIGURATION
# ============================================
DEFAULT_CURRENCY=COP
DEFAULT_LANGUAGE=es
TIMEZONE=America/Bogota

# ============================================
# FILE UPLOAD LIMITS
# ============================================
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,xlsx,csv

# ============================================
# REDIS (opcional para cache)
# ============================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ============================================
# EMAIL CONFIGURATION (opcional)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=tu_email@gmail.com
# SMTP_PASSWORD=tu_password_app
# FROM_EMAIL=noreply@baudex.com

# ============================================
# MONITORING (opcional)
# ============================================
# SENTRY_DSN=https://tu-sentry-dsn
# NEW_RELIC_LICENSE_KEY=tu_new_relic_key

# ============================================
# BACKUP CONFIGURATION
# ============================================
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Solo para desarrollo - NO usar en producción
DEBUG_MODE=false
TYPEORM_LOGGING=false
TYPEORM_SYNCHRONIZE=false

# ============================================
# INSTRUCCIONES
# ============================================
# 1. Copia este archivo como .env
# 2. Cambia todos los passwords por valores seguros
# 3. Ajusta la configuración según tu entorno
# 4. Para Docker, usar DB_HOST=db
# 5. Para producción, cambia NODE_ENV=production